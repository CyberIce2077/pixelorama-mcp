{
  "name": "pixelorama-mcp",
  "version": "0.1.0",
  "description": "MCP server and Pixelorama extension that let AI agents draw pixel art in Pixelorama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberIce2077/pixelorama-mcp.git"
  },
  "type": "module",
  "bin": {
    "pixelorama-mcp": "dist/index.js"
  },
  "files": [
